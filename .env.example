VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# ── Automatos Widget SDK ────────────────────────────────────────────
# WORKSPACE_ID is the legacy direct-fetch path used by /blog and
# /research pages. Slated for deprecation once the widget covers all
# read paths.
VITE_AUTOMATOS_WORKSPACE_ID=your_workspace_id_here

# PUBLIC_KEY (ak_pub_*) is the unified auth used by the chat + blog
# widgets via widgets.automatos.app/v0/widget.global.js. Must be a
# public key with the right `allowed_domains` including this site.
# Mint via: POST /api/api-keys with {key_type:"public",
# permissions:["chat","blog"], allowed_domains:["automatos.app",
# "www.automatos.app", "localhost:5173"]}.
VITE_AUTOMATOS_PUBLIC_KEY=ak_pub_your_public_key_here

# Contact form SMTP (Namecheap Private Email)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=Gerard@automatos.app
SMTP_PASS=your_email_password_here
CONTACT_EMAIL=Gerard@automatos.app
